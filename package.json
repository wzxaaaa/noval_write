{
  "name": "noval-write",
  "version": "1.0.0",
  "description": "AI-powered novel editor with multi-agent collaboration",
  "author": "二维漫写",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "preview": "electron-vite preview",
    "test": "vitest",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.novalwrite.desktop",
    "productName": "二维漫写",
    "executableName": "noval-write",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "二维漫写"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@radix-ui/react-context-menu": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tiptap/extension-placeholder": "^2.9.0",
    "@tiptap/pm": "^2.9.0",
    "@tiptap/react": "^2.9.0",
    "@tiptap/starter-kit": "^2.9.0",
    "better-sqlite3": "^11.6.0",
    "minisearch": "^7.1.0",
    "openai": "^4.73.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "electron": "^31.7.0",
    "electron-builder": "^25.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron-vite": "^4.0.1",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
